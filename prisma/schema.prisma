// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- KİMLİK DOĞRULAMA & KULLANICI ---
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?   // E-posta/şifre girişi için hash'lenmiş parola
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // İlişkiler
  subjects          Subject[]
  exams             Exam[]
  availabilitySlots AvailabilitySlot[]
  studyPlans        StudyPlan[]
  studyTasks        StudyTask[]
  studySessions     StudySession[]
  assessments       AssessmentResult[]
  recommendations   AiRecommendation[]
  conversations     ChatConversation[]
}

// --- AKADEMİK YÖNETİM ---
model Subject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String?  // Arayüzde dersi ayırt etmek için (örn: #ef4444)
  priority    Int      @default(1) // 1: Düşük, 2: Orta, 3: Yüksek
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics      Topic[]
  exams       Exam[]
  studyTasks  StudyTask[]
  assessments AssessmentResult[]
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  difficulty  Int      @default(2) // 1: Kolay, 2: Orta, 3: Zor
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studyTasks  StudyTask[]
  assessments AssessmentResult[]
}

model Exam {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String
  title       String
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// --- ZAMAN VE PLANLAMA ---
model AvailabilitySlot {
  id          String   @id @default(cuid())
  userId      String
  dayOfWeek   Int      // 0: Pazar, 1: Pazartesi ... 6: Cumartesi
  startTime   String   // "09:00" formatında
  endTime     String   // "11:30" formatında

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true) // Yeni plan onaylandığında eskisi false yapılır
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       StudyTask[]
}

model StudyTask {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  subjectId       String
  topicId         String?
  title           String
  date            DateTime // Planlanan tarih
  startTime       String   // Planlanan başlangıç "10:00"
  durationMinutes Int      // Örn: 90 dakika

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        StudyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic       Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sessions    StudySession[]
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  taskId          String
  actualStartTime DateTime?
  actualEndTime   DateTime?
  actualDuration  Int?     // Dakika cinsinden gerçekleşen süre
  status          String   @default("PENDING") // PENDING, COMPLETED, PARTIAL, MISSED
  notes           String?
  createdAt       DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        StudyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// --- ANALİTİK VE YAPAY ZEKA ---
model AssessmentResult {
  id          String   @id @default(cuid())
  userId      String
  subjectId   String
  topicId     String?
  type        String   // QUIZ, PRACTICE_EXAM
  score       Float
  maxScore    Float    @default(100)
  date        DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
}

model AiRecommendation {
  id          String   @id @default(cuid())
  userId      String
  content     String   @db.Text
  metricsData Json?    // AI'ın karar verirken kullandığı metriklerin snapshot'ı
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatConversation {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // USER veya AI
  content        String   @db.Text
  metricsData    Json?    // Yanıt üretilirken kullanılan veritabanı sonuçları
  createdAt      DateTime @default(now())

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}